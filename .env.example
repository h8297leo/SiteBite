# No API keys required. Endpoints can be changed to self-hosted services.
PORT=3000
PHOTON_URL=https://photon.komoot.io
OVERPASS_URL=
# Optional public source configuration. No keys. Empty OVERPASS_URL enables the two default endpoints.
WIKIPEDIA_URL=https://en.wikipedia.org
WIKIVOYAGE_URL=https://en.wikivoyage.org
# Taiwan official downloads may reject automated access; failures are reported and never bypassed.
TAIWAN_FOOD_URL=https://media.taiwan.net.tw/XMLReleaseAll_public/v2.0/Zh_tw/Restaurant-json.zip
TAIWAN_ATTRACTION_URL=https://media.taiwan.net.tw/XMLReleaseAll_public/v2.0/Zh_tw/Attraction-json.zip
# Optional ONLY: a self-hosted or explicitly authorized public HTTPS SearXNG instance.
# Local/private hosts remain forbidden by SSRF protection. JSON must be enabled.
# SEARXNG_URL=https://your-authorized-search.example/
SEARXNG_AUTOMATION_ALLOWED=false
# Regional HTML articles: only after checking access permission and terms. robots.txt is enforced.
# WEB_SOURCE_URLS=[{"url":"https://authorized-source.example/article","country":"JP","mode":"food","automationAllowed":true,"officialLocationAuthority":false}]
# officialLocationAuthority=true is only for an official publisher's authoritative place coordinates.

# Phase 2.1R: default public news/article discovery, not a general internet index.
GDELT_ENABLED=true
# Public PTT HTML search remains subject to robots, availability and access restrictions.
PTT_PUBLIC_SEARCH_ENABLED=true
# Optional: exact forum hosts for which you have obtained content-access permission.
# FORUM_AUTHORIZED_DOMAINS=authorized-forum.example
# Optional replacement for the bounded address-verification service (public HTTPS only).
NOMINATIM_URL=https://nominatim.openstreetmap.org
